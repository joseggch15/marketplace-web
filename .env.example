# Variables de entorno del frontend.
#
# Regla del proyecto: solo lo público lleva el prefijo NEXT_PUBLIC_.
# Nada de aquí debe ser un secreto de producción, excepto las credenciales de S3, que **solo** se usan en
# el servidor (proxy /api/media) y nunca se envían al navegador.

# URL del backend FastAPI (solo servidor).
BACKEND_URL=http://127.0.0.1:8000

# URL pública del sitio: metadata, canonical, hreflang y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Almacenamiento de objetos (MinIO/S3). Debe coincidir con la configuración del backend.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=marketplace
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
